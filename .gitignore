# https://dart.dev/tools/private-files
.dart_tool/
build/

# Workspace lock is committed on purpose: CI and benchmarks must be reproducible.
# (Individual package locks are not used inside a workspace.)

# agent scratch (not part of the package)
.agents/

# local benchmark / build output
bench.jsonl
*.exe
bench_out.txt
*.log

# comparison harness build/runtime output
benchmarks/compare/out/
benchmarks/compare/dart/.tmp/
benchmarks/compare/dart/bin/libisar.*
benchmarks/compare/rust/target/
benchmarks/compare/rust/sled_db/
benchmarks/compare/dart/.dart_tool/

# benchmark output (regenerated by CI, never committed)
benchmarks/results/

# throwaway compile smoke artifacts
.tmp_smoke.*
